# ==========================================
# AI E-COMMERCE PLATFORM (UZBEKISTAN)
# Environment Configuration Template
# ==========================================

# Application
NODE_ENV=development
PORT=4000
WEB_PORT=3000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=ecommerce_uz
DB_PORT=5432
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/ecommerce_uz?schema=public"

# Redis Cache & Sessions
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKeyUzbekistan2026

# Authentication & Security
JWT_SECRET=supersecretuzbekistankey2026_jwt_token_auth
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=supersecretuzbekistankey2026_refresh_token
JWT_REFRESH_EXPIRES_IN=7d

# AI Providers
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Payment Gateways (Uzbekistan)
# Payme Merchant Test Credentials
PAYME_MERCHANT_ID=64a1b2c3d4e5f6g7h8i9
PAYME_SECRET_KEY=payme_test_secret_key_uzbekistan
PAYME_ENDPOINT=https://checkout.test.paycom.uz

# Click Merchant Test Credentials
CLICK_MERCHANT_ID=12345
CLICK_SERVICE_ID=67890
CLICK_SECRET_KEY=click_test_secret_key_uzbekistan
CLICK_ENDPOINT=https://my.click.uz/services/pay

# Uzum Nasiya API Sandbox
UZUM_NASIYA_API_KEY=uzum_nasiya_sandbox_key
UZUM_NASIYA_API_URL=https://api.test.uzumnasiya.uz/v1

# Storage (S3 / MinIO compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=ecommerce-products
S3_REGION=us-east-1
